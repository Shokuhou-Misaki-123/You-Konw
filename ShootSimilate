import tkinter as tk
import math
import random
from operator import truediv
from tkinter import ttk


class Bullet:
    """子弹类"""

    def __init__(self, x, y, angle, canvas, speed=15):
        self.x = x
        self.y = y
        self.angle = angle
        self.speed = speed
        self.life = 120  # 生命周期
        self.canvas = canvas
        self.id = None

    def update(self):
        # 弧度转角度, 求出X和Y的射击坐标
        self.x += math.cos(self.angle) * self.speed
        self.y += math.sin(self.angle) * self.speed
        self.life -= 1

        # 更新画布上的显示
        if self.id is None:
            # 首次创建椭圆
            self.id = self.canvas.create_oval(
                self.x - 3, self.y - 3, self.x + 3, self.y + 3,
                fill='#FFD700', outline=''
            )
        else:
            # 移动已存在的椭圆
            self.canvas.coords(
                self.id,
                self.x - 3, self.y - 3, self.x + 3, self.y + 3
            )

    def is_alive(self):
        return self.life > 0 and 0 < self.x < 1200 and 0 < self.y < 800


class ScatteringSimulator:
    """散射模拟器主类"""

    def __init__(self, root):
        self.root = root
        self.root.title("俯视角射击散射模拟")

        # 创建主画布
        self.canvas = tk.Canvas(root, width=1200, height=800, bg='#1a1a1a')
        self.canvas.pack()

        # 可调节参数
        self.params = {
            'hipfire_spread': tk.DoubleVar(value=15.0),  # 腰射散射
            'ads_spread': tk.DoubleVar(value=3.0),  # 精确散射
            'vertical_recoil': tk.DoubleVar(value=5.0),  # 垂直后坐力
            'horizontal_recoil': tk.DoubleVar(value=2.0),  # 水平后坐力
            'move_spread_penalty': tk.DoubleVar(value=8.0)  # 移动惩罚
        }

        # 状态变量
        self.is_ads = False
        self.is_moving = False
        self.current_recoil_x = 0.0
        self.current_recoil_y = 0.0
        self.bullets = []
        self.impact_points = []
        self.impact_point_ids = []

        # 控制相关
        self.shoot_cooldown = 0
        self.mouse_x = 600
        self.mouse_y = 400

        # 玩家位置
        self.player_x = 600
        self.player_y = 700

        # 创建UI
        self.create_ui()

        # 绑定事件
        self.bind_events()

        # 启动游戏循环
        self.game_loop()

    def create_ui(self):
        """创建控制面板"""
        # 主框架
        panel_frame = ttk.Frame(self.root, padding="10")
        panel_frame.place(x=10, y=10, width=350, height=280)

        # 标题
        ttk.Label(panel_frame, text="散射参数控制",
                  font=('Arial', 12, 'bold')).grid(row=0, column=0, columnspan=3, pady=(0, 10))

        # 参数控制滑块
        params_config = [
            ("腰射散射", 'hipfire_spread', 0, 45, 1),
            ("精确散射", 'ads_spread', 0, 30, 0.5),
            ("垂直后坐力", 'vertical_recoil', 0, 30, 1),
            ("水平后坐力", 'horizontal_recoil', 0, 20, 0.5),
            ("移动惩罚", 'move_spread_penalty', 0, 30, 1),
        ]

        for i, (label, key, min_val, max_val, step) in enumerate(params_config, 1):
            ttk.Label(panel_frame, text=label).grid(row=i, column=0, sticky='w', pady=2)
            scale = ttk.Scale(panel_frame, from_=min_val, to=max_val,
                              variable=self.params[key], orient='horizontal', length=150)
            scale.grid(row=i, column=1, pady=2)
            label_val = ttk.Label(panel_frame, textvariable=self.params[key], width=5)
            label_val.grid(row=i, column=2, pady=2)
            self.params[key].trace('w', lambda *args, k=key: self.update_param_label(k))

        # 状态显示
        self.status_var = tk.StringVar(value="状态: 腰射 | 静止")
        ttk.Label(panel_frame, textvariable=self.status_var,
                  font=('Arial', 10, 'bold')).grid(row=6, column=0, columnspan=3, pady=(10, 5))

        # 操作说明
        instructions = [
            "鼠标移动: 控制射击方向",
            "鼠标左键: 射击",
            "鼠标右键: 精确瞄准(按住)",
            "WASD: 移动角色",
            "空格键: 重置后坐力"
        ]

        for i, text in enumerate(instructions, 7):
            ttk.Label(panel_frame, text=text, font=('Arial', 9)).grid(
                row=i, column=0, columnspan=3, sticky='w', padx=5
            )

        # 绘制地面网格
        self.draw_grid()

    def update_param_label(self, key):
        """更新参数标签"""
        # 强制更新显示值
        self.root.update_idletasks()

    def draw_grid(self):
        """绘制背景网格"""
        grid_size = 50
        for x in range(0, 1201, grid_size):
            self.canvas.create_line(x, 0, x, 800, fill='#333333', width=1)
        for y in range(0, 801, grid_size):
            self.canvas.create_line(0, y, 1200, y, fill='#333333', width=1)

    def bind_events(self):
        """绑定输入事件"""
        # 鼠标事件
        self.canvas.bind('<Motion>', self.on_mouse_move)
        self.canvas.bind('<Button-1>', self.on_mouse_press)  # 左键
        self.canvas.bind('<ButtonRelease-1>', self.on_mouse_release)
        self.canvas.bind('<Button-3>', lambda e: self.set_ads(True))  # 右键按下
        self.canvas.bind('<ButtonRelease-3>', lambda e: self.set_ads(False))  # 右键释放

        # 键盘事件
        self.root.bind('<KeyPress>', self.on_key_press)
        self.root.bind('<KeyRelease>', self.on_key_release)

        # 跟踪按键状态
        self.keys_pressed = set()
        self.mouse_pressed = False

    def set_ads(self, ads):
        """设置瞄准状态"""
        self.is_ads = ads
        self.update_status()

    def update_status(self):
        """更新状态显示"""
        ads_status = "精确瞄准" if self.is_ads else "腰射"
        move_status = "移动中" if self.is_moving else "静止"
        self.status_var.set(f"状态: {ads_status} | {move_status}")

    def on_mouse_move(self, event):
        """鼠标移动事件"""
        self.mouse_x = event.x
        self.mouse_y = event.y

    def on_mouse_press(self, event):
        """鼠标按下事件"""
        self.mouse_pressed = True

    def on_mouse_release(self, event):
        """鼠标释放事件"""
        self.mouse_pressed = False

    def on_key_press(self, event):
        """键盘按下事件"""
        self.keys_pressed.add(event.keysym)

        # 重置后坐力
        if event.keysym == 'space':
            self.current_recoil_x = 0
            self.current_recoil_y = 0

    def on_key_release(self, event):
        """键盘释放事件"""
        self.keys_pressed.discard(event.keysym)

    def calculate_target_angle(self):
        """计算射击目标角度"""
        dx = self.mouse_x - self.player_x
        dy = self.mouse_y - self.player_y
        return math.atan2(dy, dx)

    def shoot(self):
        """发射子弹"""
        if self.shoot_cooldown > 0:
            return

        # 计算当前基础散射
        base_spread = self.params['ads_spread'].get() if self.is_ads else self.params['hipfire_spread'].get()

        # 移动惩罚
        if self.is_moving:
            base_spread += self.params['move_spread_penalty'].get()

        # 后坐力累积
        vert_recoil = self.params['vertical_recoil'].get()
        horiz_recoil = self.params['horizontal_recoil'].get()

        self.current_recoil_y += random.uniform(-vert_recoil, vert_recoil)
        self.current_recoil_x += random.uniform(-horiz_recoil, horiz_recoil)

        # 限制后坐力
        self.current_recoil_x = max(-30, min(30, self.current_recoil_x))
        self.current_recoil_y = max(-30, min(30, self.current_recoil_y))

        # 计算最终散射角度
        spread_angle = math.radians(base_spread + abs(self.current_recoil_y) * 0.5)
        angle_variance = random.uniform(-spread_angle, spread_angle)
        target_angle = self.calculate_target_angle()
        final_angle = target_angle + angle_variance + math.radians(self.current_recoil_x * 0.1)

        # 创建子弹
        bullet = Bullet(self.player_x, self.player_y, final_angle, self.canvas)
        self.bullets.append(bullet)

        # 记录弹着点
        distance = 400
        impact_x = self.player_x + math.cos(final_angle) * distance
        impact_y = self.player_y + math.sin(final_angle) * distance

        # 创建弹着点标记
        point_id = self.canvas.create_oval(
            impact_x - 2, impact_y - 2, impact_x + 2, impact_y + 2,
            fill='#FF0000', outline=''
        )
        self.impact_points.append((impact_x, impact_y))
        self.impact_point_ids.append(point_id)

        # 限制弹着点数量
        if len(self.impact_points) > 40:
            old_point_id = self.impact_point_ids.pop(0)
            self.canvas.delete(old_point_id)
            self.impact_points.pop(0)

        # 设置冷却
        self.shoot_cooldown = 6

        # 视觉反馈：枪口闪光
        self.create_muzzle_flash()

    def create_muzzle_flash(self):
        """创建枪口闪光效果"""
        angle = self.calculate_target_angle()
        flash_x = self.player_x + math.cos(angle) * 20
        flash_y = self.player_y + math.sin(angle) * 20

        flash_id = self.canvas.create_oval(
            flash_x - 8, flash_y - 8, flash_x + 8, flash_y + 8,
            fill='#FFFF99', outline=''
        )
        # 100ms后删除
        self.root.after(100, lambda: self.canvas.delete(flash_id))

    def update_player(self):
        """更新玩家位置和状态"""
        # 移动处理
        move_speed = 3
        self.is_moving = False

        if 'w' in self.keys_pressed:
            self.player_y -= move_speed
            self.is_moving = True
        if 's' in self.keys_pressed:
            self.player_y += move_speed
            self.is_moving = True
        if 'a' in self.keys_pressed:
            self.player_x -= move_speed
            self.is_moving = True
        if 'd' in self.keys_pressed:
            self.player_x += move_speed
            self.is_moving = True

        # 边界限制
        self.player_x = max(30, min(1170, self.player_x))
        self.player_y = max(30, min(770, self.player_y))

        self.update_status()

        # 自动射击（鼠标按住）
        if self.mouse_pressed:
            self.shoot()

    def draw_scene(self):
        """绘制场景"""
        # 清空动态元素
        self.canvas.delete('dynamic')

        # 绘制玩家
        self.canvas.create_oval(
            self.player_x - 15, self.player_y - 15,
            self.player_x + 15, self.player_y + 15,
            fill='#6699FF', outline='#FFFFFF', width=2,
            tags='dynamic'
        )

        # 绘制瞄准线
        angle = self.calculate_target_angle()
        line_end_x = self.player_x + math.cos(angle) * 60
        line_end_y = self.player_y + math.sin(angle) * 60

        self.canvas.create_line(
            self.player_x, self.player_y,
            line_end_x, line_end_y,
            fill='#CCCCCC', width=1, dash=(4, 4),
            tags='dynamic'
        )

        # 绘制准星
        crosshair_size = 15
        crosshair_x = self.player_x + math.cos(angle) * 45
        crosshair_y = self.player_y + math.sin(angle) * 45

        self.canvas.create_line(
            crosshair_x - crosshair_size, crosshair_y,
            crosshair_x + crosshair_size, crosshair_y,
            fill='#FF3232', width=2, tags='dynamic'
        )
        self.canvas.create_line(
            crosshair_x, crosshair_y - crosshair_size,
            crosshair_x, crosshair_y + crosshair_size,
            fill='#FF3232', width=2, tags='dynamic'
        )

        # 绘制子弹
        for bullet in self.bullets:
            bullet.update()

        # 绘制散射范围（最近10发）
        if len(self.impact_points) >= 10:
            recent_points = self.impact_points[-10:]
            avg_x = sum(p[0] for p in recent_points) / 10
            avg_y = sum(p[1] for p in recent_points) / 10

            max_dist = max(
                math.hypot(p[0] - avg_x, p[1] - avg_y)
                for p in recent_points
            )

            self.canvas.create_oval(
                avg_x - max_dist, avg_y - max_dist,
                avg_x + max_dist, avg_y + max_dist,
                outline='#FF6666', width=1, dash=(2, 2),
                tags='dynamic'
            )

            # 显示散射直径
            self.canvas.create_text(
                1050, 20, text=f"散射直径: {max_dist * 2:.0f}像素",
                fill='#FF9999', font=('Arial', 10, 'bold'),
                tags='dynamic'
            )

    def update_game_logic(self):
        """更新游戏逻辑"""
        # 更新子弹列表（移除死亡子弹）
        self.bullets = [b for b in self.bullets if b.is_alive()]

        # 衰减后坐力
        if self.shoot_cooldown <= 0:
            self.current_recoil_x *= 0.85
            self.current_recoil_y *= 0.85

        # 更新冷却
        if self.shoot_cooldown > 0:
            self.shoot_cooldown -= 1

    def game_loop(self):
        """主游戏循环"""
        # 更新玩家
        self.update_player()

        # 更新游戏逻辑
        self.update_game_logic()

        # 绘制场景
        self.draw_scene()

        # 继续循环
        self.root.after(16, self.game_loop)  # 约60 FPS

def main():
    root = tk.Tk()
    root.resizable(False, False)

    # 设置窗口图标（可选）
    try:
        root.iconbitmap(default=None)  # 可以设置图标路径
    except:
        pass

    app = ScatteringSimulator(root)
    root.mainloop()

if __name__ == "__main__":
    main()
